<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HomeApp.Views.MainPage"
             Title="Koti">
  <CollectionView ItemsSource="{Binding Devices}" x:Name="DevicesView">
    <CollectionView.ItemTemplate>
      <DataTemplate>
        <Grid Padding="12" ColumnDefinitions="*,Auto">
          <VerticalStackLayout>
            <Label Text="{Binding Name}" FontAttributes="Bold" />
            <Label Text="{Binding Room}" FontSize="12" />
          </VerticalStackLayout>
          <Switch IsToggled="{Binding IsOn}" VerticalOptions="Center" />
        </Grid>
      </DataTemplate>
    </CollectionView.ItemTemplate>
  </CollectionView>
</ContentPage>