  {
    "id": "fn_boost",
    "type": "function",
    "z": "b126b20e",
    "name": "\u2192 REG Boost",
    "func": "\n// msg.payload: 1=on 0=off; optionally msg.minutes for duration\n// Placeholder register 41010 for boost toggle and 41011 for minutes\nvar on = Number(msg.payload) ? 1 : 0;\n\nvar msgs = [];\nvar toggle = { fc:6, unitid:1, address:41010, quantity:1, payload:[on] };\nmsgs.push(toggle);\n\nif (on && typeof msg.minutes !== 'undefined') {\n  msgs.push({ fc:6, unitid:1, address:41011, quantity:1, payload:[ Number(msg.minutes) ] });\n}\n\nreturn [msgs];\n",
    "outputs": 1,
    "noerr": 0,
    "x": 400,
    "y": 240,
    "wires": [
      [
        "mbw_vallox"
      ]
    ]
  },
