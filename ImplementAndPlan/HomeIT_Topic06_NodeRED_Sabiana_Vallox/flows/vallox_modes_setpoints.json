  {
    "id": "fn_night",
    "type": "function",
    "z": "b126b20e",
    "name": "\u2192 REG NightMode",
    "func": "\n// msg.payload: 1 or 0\n// Write to holding register for Night Mode (placeholder address 41001)\nmsg.fc = 6;           // write single holding register\nmsg.unitid = 1;\nmsg.address = 41001;  // TODO: set correct register\nmsg.quantity = 1;\nmsg.payload = [ Number(msg.payload) ];\nreturn msg;\n",
    "outputs": 1,
    "noerr": 0,
    "x": 420,
    "y": 120,
    "wires": [
