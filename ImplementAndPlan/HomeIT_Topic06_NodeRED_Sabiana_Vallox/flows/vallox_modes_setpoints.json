    "func": "\n// msg.payload: 0..100 (%)\n// Placeholder register 41100\nmsg.fc = 6; msg.unitid = 1; msg.address = 41100; msg.quantity = 1;\nmsg.payload = [ Math.max(0, Math.min(100, Number(msg.payload))) ];\nreturn msg;\n",
