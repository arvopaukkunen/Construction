  {
    "id": "fn_summer",
    "type": "function",
    "z": "33dc0db3",
    "name": "summer_rules \u2192 speed",
    "func": "// Input: msg.payload = temperature (\u00b0C)\n// Rules: >28 \u2192 MAX(3), 24< t <28 \u2192 MED(2), <=24 \u2192 OFF(0)\nvar t = Number(msg.payload);\nvar speed = 0;\nif (t > 28) speed = 3;\nelse if (t > 24 && t < 28) speed = 2;\nelse speed = 0;\n\n// Prepare Modbus single holding register write (FC=6)\n// Adjust address to match Sabiana fan speed register\nmsg.fc = 6;\nmsg.unitid = 1;\nmsg.address = 40010; // TODO: set correct address\nmsg.quantity = 1;\nmsg.payload = [ speed ];\nmsg.topic = \"sabiana/fan_speed\";\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 440,
    "y": 120,
    "wires": [
      [
        "mbw_sabiana_speed",
        "debug_summer"
      ]
    ]
  },
