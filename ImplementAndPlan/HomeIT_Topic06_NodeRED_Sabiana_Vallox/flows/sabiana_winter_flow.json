    "id": "fn_winter",
    "type": "function",
    "z": "5a380f1f",
    "name": "winter_rules \u2192 speed",
    "func": "// Rules:\n// temp < 18 \u2192 MAX(3)\n// 17 < temp < 25 \u2192 MED(2)\n// 24 < temp < 30 \u2192 MIN(1)\n// temp >= 30 \u2192 OFF(0)\nvar t = Number(msg.payload);\nvar speed = 0;\nif (t < 18) speed = 3;\nelse if (t > 17 && t < 25) speed = 2;\nelse if (t > 24 && t < 30) speed = 1;\nelse speed = 0;\n\nmsg.fc = 6;\nmsg.unitid = 1;\nmsg.address = 40010; // TODO: set correct register\nmsg.quantity = 1;\nmsg.payload = [ speed ];\nmsg.topic = \"sabiana/fan_speed\";\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 440,
    "y": 120,
    "wires": [
      [
        "mbw_sabiana_speed_w",
        "debug_winter"
      ]
    ]
